{
  "name": "@gobob/tokenlist",
  "version": "1.0.0",
  "description": "BOB token list data and utilities",
  "license": "MIT",
  "main": "index.ts",
  "packageManager": "pnpm@11.24.0",
  "files": [
    "index.ts",
    "config.ts",
    "types.ts",
    "utils.ts",
    "token-ids.ts",
    "tokenlist.json",
    "tokenlist*.json",
    "chainlist.json",
    "compressedlist.json"
  ],
  "scripts": {
    "build": "npm run build:types && npm run build:tokenlist && npm run build:chainlist && npm run build:compressedlist && npm run format:write",
    "build:chainlist": "tsx ./scripts/build-chainlist.ts",
    "build:compressedlist": "tsx ./scripts/build-compressedlist.ts",
    "build:tokenlist": "tsx ./scripts/build-tokenlist.ts",
    "build:types": "tsx ./scripts/build-types.ts",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "format": "biome format .",
    "format:write": "biome format --write .",
    "lint": "biome lint .",
    "postbuild": "npm run verify",
    "publish:assets": "tsx ./scripts/publish-assets.ts",
    "verify": "tsx ./scripts/verify.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1121.0",
    "@biomejs/biome": "^2.5.11",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "glob": "^13.0.6",
    "lodash": "^4.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@scure/base": "^2.4.0",
    "viem": "^2.56.0"
  }
}
